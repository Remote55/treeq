    "generate": "python3 tools/generate_contract.py",
    "check:drift": "python3 tools/generate_contract.py --check"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
