{
  "name": "@treeq/run-contract",
  "version": "2.0.0",
  "private": true,
  "description": "Versioned RunRequest/RunReport contract shared by the TreeQ API, ML pipeline and web client",
  "type": "module",
  "main": "./typescript/src/index.ts",
  "types": "./typescript/src/index.ts",
  "exports": {
    ".": "./typescript/src/index.ts",
    "./schema/*": "./schema/*"
  },
  "files": [
    "typescript/src",
